# Configuración SFTP GoAnywhere
SFTP_HOST=mft.ejemplo.gov.co
SFTP_PORT=2243
SFTP_USERNAME=usuario_ejemplo
SFTP_PASSWORD=password_ejemplo

# Configuración de timeouts
TIMEOUT_CONEXION=30
TIMEOUT_OPERACION=20
TIMEOUT_ARCHIVO=60

# Configuración de reintentos
MAX_REINTENTOS_CONEXION=5
MAX_REINTENTOS_OPERACION=3
BACKOFF_BASE=2.0
KEEPALIVE_INTERVAL=5

# Carpetas SFTP
CARPETA_PRINCIPAL=R.A-ABASTECIMIENTO RED ASISTENCIAL

# Configuración de la aplicación
DEBUG=True
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=outputs
MAX_SEDES=50

# ── Base de datos PostgreSQL ──
# (Coincide con la configuración del docker-compose.yml)
DATABASE_URL=postgresql://consolidador_admin:C0ns0l1d4d0r_S3cur3_2025!@localhost:5433/consolidador_db

# ── JWT Autenticación ──
# Cambiar en producción por una cadena segura generada con: openssl rand -hex 32
JWT_SECRET=reemplazar_por_un_secreto_seguro_en_produccion!
